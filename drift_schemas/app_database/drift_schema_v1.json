  "fixed_sql": [
    {
      "name": "properties",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"properties\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"name\" TEXT NOT NULL, \"pic\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "paddocks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"paddocks\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"property_id\" TEXT NOT NULL REFERENCES properties (id), \"name\" TEXT NOT NULL, \"hectares\" REAL NOT NULL DEFAULT 0.0, \"boundary\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "templates",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"templates\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"name\" TEXT NOT NULL, \"is_built_in\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_built_in\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "livestock_classes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"livestock_classes\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"template_id\" TEXT NOT NULL REFERENCES templates (id), \"kind\" TEXT NOT NULL, \"breed\" TEXT NULL, \"age_band\" TEXT NOT NULL, \"ages_into_class_id\" TEXT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "movements",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"movements\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"occurred_at\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"from_paddock_id\" TEXT NULL REFERENCES paddocks (id), \"from_class_id\" TEXT NULL REFERENCES livestock_classes (id), \"to_paddock_id\" TEXT NULL REFERENCES paddocks (id), \"to_class_id\" TEXT NULL REFERENCES livestock_classes (id), \"head\" INTEGER NOT NULL, \"end_state\" TEXT NULL, \"note\" TEXT NULL, \"actor_id\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    }
  ]
